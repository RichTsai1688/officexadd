# Public origin exposed by Cloudflare Tunnel. This must match the hostname
# configured on the Cloudflare Tunnel route.
OFFICEXADD_PUBLIC_ORIGIN=https://your-addin.example.com

# Shared API token used by the taskpane when calling /api/.
OFFICEXADD_API_TOKEN=replace-with-a-random-secret

# Cloudflare Tunnel token for the officexadd service.
CLOUDFLARE_TUNNEL_TOKEN=replace-with-your-cloudflare-tunnel-token

# Backend settings
OPENAI_API_KEY=sk-proj-your-key-here
AI_BASE_URL=
AI_API_KEY=
MODEL_NAME=
OLLAMA_WEB_SEARCH_API_KEY=
# OLLAMA_WEB_SEARCH_URL=
GOOGLE_API_KEY=
GOOGLE_IMAGE_MODEL=gemini-3.1-flash-image-preview
GOOGLE_IMAGE_ASPECT_RATIO=1:1
# GOOGLE_IMAGE_SIZE=1K
# GOOGLE_API_BASE_URL=https://generativelanguage.googleapis.com/v1beta
